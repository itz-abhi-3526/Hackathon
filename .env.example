# ──────────────────────────────────────────────────────────────
# VOIDHACK 2026 — Frontend environment (browser)
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://plizkdbvhqmivqosraui.supabase.co

# Supabase PUBLIC / publishable key only. NEVER put the
# service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Yd_HJu2Chw72Khe9WGZbnA_RaXyWAXw

# ──────────────────────────────────────────────────────────────
# Cloudinary — browser upload via the EXISTING UNSIGNED preset.
# The preset is unsigned, so the browser may upload the payment
# screenshot directly to Cloudinary. NO secret is needed and no
# `CLOUDINARY_API_SECRET` may ever be exposed to the browser.
#
#   Cloud:   dudp2imxs
#   Preset:  hackathon
#
# Upload endpoint used at runtime:
#   https://api.cloudinary.com/v1_1/<cloud>/image/upload
# ──────────────────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=dudp2imxs
VITE_CLOUDINARY_UPLOAD_PRESET=hackathon