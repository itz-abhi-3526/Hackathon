# ──────────────────────────────────────────────────────────────
# VOIDHACK 2026 — Edge Function secrets: send-registration-email
# Copy to supabase/functions/.env.local for `supabase functions serve`
# or set as project-wide secrets with:
#
#   supabase secrets set SMTP_USER=... SMTP_PASS=...
#
# SUPABASE_URL / SUPABASE_ANON_KEY are injected automatically by the
# Edge Runtime — never set them here. The project dashboard hosts the
# SMTP secrets (Edge Functions → Secrets); they are NEVER in the
# browser bundle.
# ──────────────────────────────────────────────────────────────

# SMTP server. Gmail defaults:
#   host smtp.gmail.com, port 465, user = Gmail address, pass = App Password.
# For any other provider set these to its submission host + port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Login for the sending mailbox.
SMTP_USER=you@gmail.com
# Gmail: use an App Password (never your normal password):
#   https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password-goes-here

# Optional — overrides the From header. Defaults to SMTP_USER.
# EMAIL_FROM="VOIDHACK 2026 <you@gmail.com>"
#
# Heads-up: free-Gmail bulk sends frequently land in the recipient's
# spam folder. A verified custom domain (Resend/SendGrid + SPF/DKIM)
# is the reliable fix if deliverability matters.